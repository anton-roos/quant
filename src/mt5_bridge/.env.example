# Server configuration
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
API_KEY=change_me

# Logging and storage
LOG_DIR=./logs
JOURNAL_DB=./journal.sqlite

# Risk defaults (bridge-level guard rails)
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_TRADES=3
ALLOW_LIVE_TRADING=false

# MT5 credentials (optional if terminal already logged in)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
